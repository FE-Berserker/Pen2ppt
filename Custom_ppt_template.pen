      ],
      "children": [
        {
          "type": "frame",
          "id": "suiJy",
          "name": "header1",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "vjqlP",
              "fill": "#339999",
              "content": "1. 正文 (双栏布局)",
              "fontFamily": "Inter",
              "fontSize": 28,
              "fontWeight": "bold"
            },
            {
              "type": "rectangle",
              "id": "FYGTb",
              "fill": {
                "type": "gradient",
                "gradientType": "linear",
                "enabled": true,
                "rotation": 0,
                "size": {
                  "height": 1
                },
                "colors": [
                  {
                    "color": "#339999",
