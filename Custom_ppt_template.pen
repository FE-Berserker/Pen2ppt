        },
        {
          "type": "rectangle",
          "id": "BrmqB",
          "name": "aboutDivider2",
          "fill": {
            "type": "gradient",
            "gradientType": "linear",
            "enabled": true,
            "rotation": 0,
            "size": {
              "height": 1
