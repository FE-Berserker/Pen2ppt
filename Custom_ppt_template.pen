                  }
                ]
              },
              "width": "fill_container",
              "height": 3
            }
          ]
        },
        {
          "type": "frame",
          "id": "JHwcw",
          "name": "p1Body",
          "width": "fill_container",
          "height": "fill_container",
          "gap": 40,
          "children": [
            {
              "type": "frame",
              "id": "eLmRJ",
              "name": "p1Left",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "cDrnW",
                  "name": "p1Para1",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "曲曲折折的荷塘上面，弥望的是田田的叶子。叶子出水很高，像亭亭的舞女的裙。",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ME1RC",
                  "name": "p1Para2",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "层层的叶子中间，零星地点缀着些白花，有袅娜地开着的，有羞涩地打着朵儿的；正如一粒粒的明珠，又如碧天里的星星，又如刚出浴的美人。",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JSojt",
                  "name": "p1Para3",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "微风过处，送来缕缕清香，仿佛远处高楼上渺茫的歌声似的。这时候叶子与花也有一丝的颤动，像闪电般，霎时传过荷塘的那边去了。",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "1zLU3",
                  "name": "p1Para4",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "叶子本是肩并肩密密地挨着，这便宛然有了一道凝碧的波痕。叶子底下是脉脉的流水，遮住了，不能见一些颜色；而叶子却更见风致了。",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "M6oJw",
                  "name": "p1Quote",
                  "fill": "#666666",
                  "content": "—— 朱自清《荷塘月色》 返回 ↗",
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "HzkXW",
              "name": "p1Right",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "cTohX",
                  "name": "p1Image",
                  "metadata": {
                    "type": "unsplash",
                    "username": "ever73",
                    "link": "https://unsplash.com/@ever73",
                    "author": "Everest Louis"
                  },
                  "width": "fill_container",
                  "height": "fill_container",
                  "fill": {
                    "type": "image",
                    "enabled": true,
                    "url": "https://images.unsplash.com/photo-1691460606272-0329689c20fc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3NzY4NDEzMzR8&ixlib=rb-4.1.0&q=80&w=1080",
                    "mode": "fill"
                  },
